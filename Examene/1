def check_site(url):
    try:
        r = requests.get(url, timeout=5)

        return {
            "status": r.status_code,
            "content_type": r.headers.get("Content-Type", "lipsește"),
            "length": len(r.content),
            "server": r.headers.get("Server", "necunoscut")
        }

    except requests.exceptions.Timeout:
        return {"error": "Site-ul răspunde prea lent"}

    except requests.exceptions.RequestException:
        return {"error": "Site-ul nu poate fi accesat"}


for site in SITES:
    print(site, check_site(site))


import requests
def scan_sites():
    results = []

    for site in SITES:
        result = check_site(site)
        results.append((site, result))

    working = []

    for site, result in results:
        if result.get("status") == 200:
            working.append((site, result))

    working.sort(key=lambda x: x[1]["length"], reverse=True)

    for site, result in working:
        print(f"{site} -> 200, {result['length']} octeți")

    success = len(working)
    failed = len(SITES) - success

    print(f"Reușite: {success} | Eșuate: {failed}")

scan_sites()


