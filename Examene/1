import requests
def check_headers(url):
    try:
        r = requests.get(url, timeout=5)

        present = []
        missing = []

        for header in SECURITY_HEADERS:
            if header.lower() in [h.lower() for h in r.headers]:
                present.append(header)
            else:
                missing.append(header)

        score = int(len(present) / len(SECURITY_HEADERS) * 100)

        return {
            "present": present,
            "missing": missing,
            "score": score
        }

    except requests.RequestException as e:
        return {
            "status": None,
            "error": str(e)
        }

pass

def retry_check(url, attempts=3):
    result = {"status": None, "attempts": 0}

    for i in range(attempts):
        result["attempts"] += 1

        try:
            r = requests.get(url, timeout=5)
            result["status"] = r.status_code

            if r.status_code < 500:
                return result

        except requests.exceptions.RequestException as e:
            result["error"] = str(e)

    return result


print(retry_check("https://httpbin.org/status/200"))
print(retry_check("https://httpbin.org/status/404"))
print(retry_check("https://httpbin.org/status/500"))
print(retry_check("https://httpbin.org/status/500", attempts=2))
print(retry_check("http://this-site-does-not-exist.invalid"))

